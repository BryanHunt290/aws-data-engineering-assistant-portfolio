# Local Streamlit configuration. Copy values into your shell environment.
# Do not put credentials in this file or in the Streamlit interface.
APP_RUNTIME_MODE=demo
APP_LLM_PROVIDER=fake
APP_EMBEDDING_PROVIDER=fake
APP_VECTOR_STORE_PROVIDER=memory
AWS_REGION=us-west-2
APP_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
APP_LLM_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
APP_DEFAULT_CLIENT_ID=demo-client
APP_DEFAULT_ENVIRONMENT=dev
APP_RETRIEVAL_TOP_K=5
APP_MINIMUM_SIMILARITY=0.0
APP_MAXIMUM_CONVERSATION_MESSAGES=10
APP_DEVELOPER_MODE=false
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_EMBEDDING_MODEL=embeddinggemma
APP_OLLAMA_CHAT_MODEL=qwen3:8b
APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_COLLECTION=dea_knowledge_embeddinggemma_v1
APP_QDRANT_API_KEY=
# Automatic indexing is fail-closed. Provider names are required when enabled.
# Integration validation is a separate CDK/preflight context gate and is also
# disabled by default; it is intentionally not a Lambda environment variable.
KNOWLEDGE_AUTOMATIC_INDEXING_ENABLED=false
KNOWLEDGE_INDEXING_RUNTIME_MODE=local
KNOWLEDGE_EMBEDDING_PROVIDER=fake
KNOWLEDGE_VECTOR_STORE_PROVIDER=memory
KNOWLEDGE_EMBEDDING_MODEL_ID=fake-embedding-v1
KNOWLEDGE_EMBEDDING_BATCH_SIZE=8
KNOWLEDGE_EMBEDDING_DIMENSIONS=16
KNOWLEDGE_NAMESPACE=data-engineering
KNOWLEDGE_DOMAIN=general
KNOWLEDGE_OLLAMA_URL=http://localhost:11434
KNOWLEDGE_OLLAMA_EMBEDDING_MODEL=embeddinggemma
KNOWLEDGE_QDRANT_URL=http://localhost:6333
KNOWLEDGE_QDRANT_COLLECTION=dea_knowledge_embeddinggemma_v1
KNOWLEDGE_QDRANT_ENDPOINT_SOURCE=environment
KNOWLEDGE_QDRANT_TLS_REQUIRED=false
KNOWLEDGE_QDRANT_AUTHENTICATION_REQUIRED=false
# Production uses only a Secrets Manager identifier; never put a secret here.
KNOWLEDGE_QDRANT_SECRET_IDENTIFIER=
KNOWLEDGE_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_REQUEST_TIMEOUT_SECONDS=10
KNOWLEDGE_INDEXING_RETRY_LIMIT=2
KNOWLEDGE_MANIFEST_CONFLICT_RETRIES=3
KNOWLEDGE_MAX_DESCRIPTOR_BATCH_SIZE=10
KNOWLEDGE_MAX_CHUNKS_PER_INVOCATION=500
# Optional path to a validated, offline pricing catalog.
# APP_PRICING_CATALOG_PATH=knowledge/pricing_catalog.json

# Private bookkeeping analysis. Fake remains the safe offline default.
DEA_LLM_PROVIDER=fake
DEA_OLLAMA_BASE_URL=http://localhost:11434
DEA_OLLAMA_MODEL=gpt-oss:20b
DEA_OLLAMA_CONNECT_TIMEOUT_SECONDS=5
DEA_OLLAMA_TIMEOUT_SECONDS=120
DEA_BOOKKEEPING_MAX_UPLOAD_BYTES=5242880
DEA_BOOKKEEPING_MAX_ROWS=10000
DEA_BOOKKEEPING_CATEGORY_BATCH_SIZE=25
DEA_BOOKKEEPING_DUPLICATE_WINDOW_DAYS=3
DEA_BOOKKEEPING_KNOWLEDGE_MAX_PASSAGES=5
DEA_BOOKKEEPING_KNOWLEDGE_MAX_CONTEXT_CHARACTERS=12000
DEA_BOOKKEEPING_KNOWLEDGE_CHUNK_SIZE=1000
DEA_BOOKKEEPING_KNOWLEDGE_CHUNK_OVERLAP=100
